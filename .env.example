# ============================================================
# 头条新闻后端 — 环境变量模板（复制为 .env 后填入真实值）
# 所有敏感信息都只放在本地 .env 中，.env 不会被提交到 Git
# ============================================================

# ---------- MySQL 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=news_app
DB_CHARSET=utf8mb4
# 可选：直接覆盖完整连接串（优先级高于上面各字段）
# DATABASE_URL=mysql+aiomysql://user:pass@host:port/dbname?charset=utf8mb4

# ---------- 数据库连接池 ----------
DB_ECHO_SQL=false       # true 会把所有 SQL 打到控制台（开发时用）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Redis 缓存 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 如果 Redis 没设密码，保持为空即可：REDIS_PASSWORD=
REDIS_PASSWORD=
REDIS_TIMEOUT=2

# ---------- 应用服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
